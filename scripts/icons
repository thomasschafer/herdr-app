#!/bin/bash
# Builds the app icons from assets/icons/herdr-ui-icon-clean.svg, the one
# source: the 1024px PNG, Herdr.icns (macOS) and herdr-app.ico (Windows).
# Run it after editing the SVG and commit the results.
#
# macOS only (sips, iconutil). Google Chrome renders the SVG, as it supports
# every filter and mask the icon uses; CHROME overrides where to find it.
set -euo pipefail
cd "$(dirname "$0")/.."

[[ $(uname -s) == Darwin ]] || { echo 'scripts/icons requires macOS (sips, iconutil).' >&2; exit 1; }
chrome=${CHROME:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}
[[ -x $chrome ]] || { echo "Google Chrome not found at $chrome; set CHROME to its binary." >&2; exit 1; }

icons=assets/icons
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

"$chrome" --headless --disable-gpu --hide-scrollbars --user-data-dir="$work/chrome" \
  --force-device-scale-factor=1 --default-background-color=00000000 --window-size=1024,1024 \
  --screenshot="$work/icon.png" "file://$PWD/$icons/herdr-ui-icon-clean.svg" 2>/dev/null
size=$(sips -g pixelWidth -g pixelHeight "$work/icon.png" | awk '/pixel/ { printf "%s ", $2 }')
[[ $size == '1024 1024 ' ]] || { echo "Chrome rendered a ${size:-missing }image, expected 1024x1024." >&2; exit 1; }
cp "$work/icon.png" "$icons/herdr-ui-icon-clean.png"

# Scales the 1024px render down to $1 pixels square, into $2.
scaled() { sips -z "$1" "$1" "$work/icon.png" --out "$2" >/dev/null; }

mkdir "$work/Herdr.iconset"
for s in 16 32 128 256 512; do
  scaled "$s" "$work/Herdr.iconset/icon_${s}x${s}.png"
  scaled $((s * 2)) "$work/Herdr.iconset/icon_${s}x${s}@2x.png"
done
iconutil -c icns -o "$icons/Herdr.icns" "$work/Herdr.iconset"

ico_sizes=(256 64 48 32 24 16)
ico_pngs=()
for s in "${ico_sizes[@]}"; do
  scaled "$s" "$work/ico-$s.png"
  ico_pngs+=("$work/ico-$s.png")
done
python3 -I - "$icons/herdr-app.ico" "${ico_pngs[@]}" <<'PY'
# Writes the PNGs as 32-bit bitmaps in one .ico, the form every Windows
# resource compiler accepts.
import struct, sys, zlib

def rgba(path):
    data = open(path, "rb").read()
    assert data[:8] == b"\x89PNG\r\n\x1a\n", f"{path} is not a PNG"
    pos, idat, header = 8, b"", None
    while pos < len(data):
        (n,) = struct.unpack(">I", data[pos:pos + 4])
        kind, body = data[pos + 4:pos + 8], data[pos + 8:pos + 8 + n]
        if kind == b"IHDR":
            header = struct.unpack(">IIBBBBB", body)
        elif kind == b"IDAT":
            idat += body
        pos += 12 + n
    w, h, depth, colour, _, _, interlace = header
    assert (depth, colour, interlace) == (8, 6, 0), f"{path}: expected 8-bit RGBA, not interlaced"
    raw, stride, rows, prev = zlib.decompress(idat), w * 4, [], bytearray(w * 4)
    for y in range(h):
        kind, line = raw[y * (stride + 1)], bytearray(raw[y * (stride + 1) + 1:(y + 1) * (stride + 1)])
        for i in range(stride):
            a = line[i - 4] if i >= 4 else 0
            b = prev[i]
            c = prev[i - 4] if i >= 4 else 0
            if kind == 1:
                line[i] = (line[i] + a) & 255
            elif kind == 2:
                line[i] = (line[i] + b) & 255
            elif kind == 3:
                line[i] = (line[i] + (a + b) // 2) & 255
            elif kind == 4:
                p = a + b - c
                pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
                line[i] = (line[i] + (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 255
            else:
                assert kind == 0, f"{path}: unknown PNG filter {kind}"
        rows.append(bytes(line))
        prev = line
    return w, h, rows

def bitmap(w, h, rows):
    pixels = b"".join(bytes(row[i + j] for i in range(0, len(row), 4) for j in (2, 1, 0, 3)) for row in reversed(rows))
    # The AND mask stays clear: the alpha channel already carries transparency.
    mask = bytes((w + 31) // 32 * 4 * h)
    return struct.pack("<IiiHHIIiiII", 40, w, h * 2, 1, 32, 0, len(pixels) + len(mask), 0, 0, 0, 0) + pixels + mask

out, paths = sys.argv[1], sys.argv[2:]
images = [(w, h, bitmap(w, h, rows)) for w, h, rows in map(rgba, paths)]
offset = 6 + 16 * len(images)
entries = b""
for w, h, bmp in images:
    assert w == h and w <= 256, f"ico images must be square and at most 256px, not {w}x{h}"
    entries += struct.pack("<BBBBHHII", w % 256, h % 256, 0, 0, 1, 32, len(bmp), offset)
    offset += len(bmp)
with open(out, "wb") as f:
    f.write(struct.pack("<HHH", 0, 1, len(images)) + entries + b"".join(bmp for _, _, bmp in images))
PY
echo "Built $icons/herdr-ui-icon-clean.png, $icons/Herdr.icns and $icons/herdr-app.ico."
